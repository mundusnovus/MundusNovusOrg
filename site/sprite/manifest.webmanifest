{
  "name": "Asteria Sprite",
  "short_name": "Sprite",
  "description": "A free, open-source pixel-art editor and animator.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0a1518",
  "theme_color": "#0a1518",
  "categories": ["graphics", "design", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/json": [".asprite.json"], "image/png": [".png"], "application/octet-stream": [".aseprite", ".ase"] } }]
}
